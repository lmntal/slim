unit_test.use.

tap_producer = {
  test_suite = {
    setup = { mell.use. }.

    test_case = {
      name = "mell.delete case 1".

      init = { mell.delete(L2,L3). f(L0). f(L1). {a(L3). }, {p(L2). p(L0). p(L1). }. }.

      ruleset = {}.

      stable = {
        a(f). a(f).
      }.
    }.
    
    test_case = {
      name = "mell.delete case 2".

      init = { {p(A),p(B),p(C)},pport(A),f(B),f(C) }.

      ruleset = { {$p[X|*X]},pport(X) :- mell.delete(X,A), {$p[X|*X]}, {a(A)}. }.

      stable = {
        a(f). a(f).
      }.
    }.
    
    test_case = {
      name = "mell.delete case 3".

      init = { {p(A),p(B),p(C)},pport(A),f(B),f(C) }.

      ruleset = { {$p[X|*X]},pport(X) :- mell.delete(X,A), {$p[X|*X]}, {a(A,N),{b(N)}}. }.

      stable = {
        f(L2). f(L3). a(L2,L0). a(L3,L1). {b(L1). }, {b(L0). }.
      }.
    }.

    teardown = { mell.use :- . }.

  }.

  test_suite = {
    setup = { mell.use. }.

    test_case = {
      name = "mell.copy case 1".

      init = { pport2(mell.copy(L2,L3,L4,L5,L7,L6,pport2)). f(L0). f(L1). {b(L7,L6). }, {a(L3,L4,L5). }, {p(L2). p(L0). p(L1). }  }.

      ruleset = {}.

      stable = {
        pport2(b(L5)). pport2(b(L2)). f(a(L0,L3)). f(a(L1,L4)). {p(L5). p(L3). p(L4). }, {p(L2). p(L0). p(L1). }.
      }.
    }.
    
    test_case = {
      name = "mell.copy case 2".

      init = { {p(A),p(B),p(C)},pport(A),f(B),f(C) }.

      ruleset = { {$p[X|*X]},pport(X) :- mell.copy(X,A1,A2,A3,B1,B2,C1,C2), {$p[X|*X]}, {a(A1,A2,A3)}, {b(B1,B2)}, pport2(C1),pport2(C2). }.

      stable = {
        pport2(b(L5)). pport2(b(L2)). f(a(L0,L3)). f(a(L1,L4)). {p(L5). p(L3). p(L4). }, {p(L2). p(L0). p(L1). }.
      }.
    }.
    
    test_case = {
      name = "mell.copy case 3".

      init = { {p(A),p(B),p(C)},pport(A),f(B),f(C) }.

      ruleset = { {$p[X|*X]},pport(X) :- mell.copy(X,A1,A2,A3,B1,B2,C1,C2), {$p[X|*X]}, {a1(A1,N),{a23(N,A2,A3)}}, {b(B1,B2)}, pport2(C1),pport2(C2). }.

      stable = {
        pport2(b(L2)). pport2(b(L9)). f(L4). f(L7). a1(L0,L5). a1(L1,L8). {a23(L8,L6,L7). }, {a23(L5,L3,L4). }, {p(L9). p(L3). p(L6). }, {p(L2). p(L0). p(L1). }.
      }.
    }.
    
    test_case = {
      name = "mell.copy case 4".

      init = { {p(A),p(B),p(C)},pport(A),f(B),f(C) }.

      ruleset = { {$p[X|*X]},pport(X) :- mell.copy(X,A1,A2,A3,B1,B2,C1,C2), {$p[X|*X]}, {a(A1,A2,A3)}, {B1=B2}, pport2(C1),pport2(C2). }.

      stable = {
        f(a(L0,L3)). f(a(L1,L4)). pport2(L2). pport2(L5). {p(L5). p(L3). p(L4). }, {p(L2). p(L0). p(L1). }.
      }.
    }.

    test_case = {
      name = "mell.copy case 5".

      init = { {p(X),f(X2)},p(X,X1,X2),f(X1) }.

      ruleset = { {$p[X|*X]},p(X,X1,X2) :- mell.copy(X,A1,A2,A3,B1,B2,X1,X2), {$p[X|*X]}, {a(A1,A2,A3)}, {b(B1,B2)}. }.

      stable = {
        f(b(L1)). a(L0,L3,b(L2)). {p(L2). f(L3). }, {p(L1). f(L0). }.
      }.
    }.
    teardown = { mell.use :- . }.

  }.

