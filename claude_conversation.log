> if I completely switch to cmake, what files/directories become unnecessary?

● If you completely switch to CMake and no longer need autotools compatibility, here are the
  files/directories you can safely remove:

  🗑️ Autotools Files to Remove

  Core Autotools Configuration

  cd /home/ueda/slim-cmake

  # Remove autotools configuration files
  rm -f configure configure.ac configure~
  rm -f Makefile.am Makefile.in Makefile
  rm -f aclocal.m4
  rm -f config.log config.status
  rm -f depcomp install-sh missing mkinstalldirs
  rm -f ltmain.sh libtool
  rm -f ylwrap test-driver compile

  Autotools Generated/Linked Files

  # Remove symbolic links to automake files
  rm -f config.guess config.sub

  # Remove autotools cache and temporary directories
  rm -rf autom4te.cache

  # Remove m4 macro directory (if only used by autotools)
  rm -rf m4

  # Remove autotools script
  rm -f autogen.sh

  Makefile.am Files Throughout Project

  # Find and remove all Makefile.am files
  find . -name "Makefile.am" -delete

  # Find and remove generated Makefiles
  find . -name "Makefile.in" -delete
  find . -name "Makefile" -type f -delete

  Old Generated Files

  # Remove old generated parser files from source directories
  rm -f src/loader/il_parser.cpp src/loader/il_parser.hpp src/loader/il_lexer.cpp
  rm -f src/verifier/nc_parser.cpp src/verifier/nc_parser.hpp src/verifier/nc_lexer.cpp
  rm -f src/verifier/propsym_parser.cpp src/verifier/propsym_parser.hpp
  src/verifier/propsym_lexer.cpp

  # Remove old generated code files
  rm -f src/loader/translate_generated.cpp src/loader/interpret_generated.cpp

  # Remove old config files
  rm -f src/config.h.in src/config.h.in~

  Build Artifacts

  # Remove any autotools build artifacts
  rm -f src/*.o src/*/*.o
  rm -rf build  # if it contains autotools build

  # Remove old libtool files
  rm -f *.la *.lo

  📁 Complete Cleanup Script

  cd /home/ueda/slim-cmake

  # Create a cleanup script
  cat > cleanup_autotools.sh << 'EOF'
  #!/bin/bash
  echo "Removing autotools files..."

  # Core autotools files
  rm -f configure configure.ac configure~
  rm -f aclocal.m4 config.log config.status
  rm -f depcomp install-sh missing mkinstalldirs
  rm -f ltmain.sh libtool
  rm -f ylwrap test-driver compile
  rm -f config.guess config.sub
  rm -f autogen.sh

  # Directories
  rm -rf autom4te.cache m4

  # All Makefile.am and generated Makefiles
  find . -name "Makefile.am" -delete
  find . -name "Makefile.in" -delete
  find . -name "Makefile" -type f -delete

  # Old generated files
  rm -f src/loader/il_parser.cpp src/loader/il_parser.hpp src/loader/il_lexer.cpp
  rm -f src/verifier/nc_parser.cpp src/verifier/nc_parser.hpp src/verifier/nc_lexer.cpp
  rm -f src/verifier/propsym_parser.cpp src/verifier/propsym_parser.hpp
  src/verifier/propsym_lexer.cpp
  rm -f src/loader/translate_generated.cpp src/loader/interpret_generated.cpp
  rm -f src/config.h.in src/config.h.in~

  echo "Autotools cleanup complete!"
  echo "CMake-only files remaining."
  EOF

  chmod +x cleanup_autotools.sh
  ./cleanup_autotools.sh

