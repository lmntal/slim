  CMAKE_MIGRATION.md
  CLAUDE.md

  # Source code (obviously)
  src/
  third_party/
  test/
  lib/
  ext/
  doc/

  # Project files
  README.md
  NEWS
  AUTHORS
  COPYING
  VERSION

